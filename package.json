{
  "name": "kbcalc",
  "version": "1.0.2",
  "description": "Floating calculator with a built-in Winamp-style MP3 player (Electron, cross-platform)",
  "author": "Richard <info@killbottleneck.com>",
  "homepage": "https://github.com/tengosro/kbcalc",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.tengolabs.kbcalc",
    "productName": "kbCalc",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "app.js",
      "app.css",
      "kbcalc.svg",
      "build/icon.png"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "contributors": [
    "Claude Fable 5 (Anthropic)"
  ]
}
